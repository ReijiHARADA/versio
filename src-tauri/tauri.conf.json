{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Versio",
  "version": "0.1.0",
  "identifier": "com.harada.versio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "bash scripts/before-build.sh"
  },
  "app": {
    "windows": [
      {
        "title": "Versio",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 12, "y": 19 }
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost http://127.0.0.1:*",
        "img-src": "'self' asset: http://asset.localhost blob: data: https:",
        "media-src": "'self' blob: data:",
        "font-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self' 'unsafe-inline' 'wasm-unsafe-eval'",
        "worker-src": "'self' blob:"
      },
      "devCsp": {
        "default-src": "'self' customprotocol: asset: http://localhost:5173 http://127.0.0.1:5173",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipc.localhost http://127.0.0.1:* http://localhost:* ws://localhost:* ws://127.0.0.1:*",
        "img-src": "'self' asset: http://asset.localhost blob: data: https:",
        "media-src": "'self' blob: data:",
        "font-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' http://localhost:5173 http://127.0.0.1:5173",
        "worker-src": "'self' blob:"
      }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/llama-server"],
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/Assets.car",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF Document",
        "description": "Academic paper",
        "mimeType": "application/pdf",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ]
  }
}
